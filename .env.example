# Keep variable names and order aligned across all environment files.
# General defaults belong in config/config.yaml.
# Environment profile and HTTP listener.
APP_ENV=development
GO_API_SERVER__PORT=9527

# MySQL connection.
GO_API_DATABASE__HOST=localhost
GO_API_DATABASE__PORT=3306
GO_API_DATABASE__USERNAME=root
GO_API_DATABASE__PASSWORD=
GO_API_DATABASE__DBNAME=go_api_starter

# S3-compatible object storage.
GO_API_STORAGE__ENDPOINT=
GO_API_STORAGE__BUCKET=
GO_API_STORAGE__REGION=
GO_API_STORAGE__ACCESS_KEY_ID=
GO_API_STORAGE__ACCESS_KEY_SECRET=
GO_API_STORAGE__UPLOAD_DIR=go_oss
GO_API_STORAGE__PUBLIC_BASE_URL=

# Authentication and API documentation credentials.
GO_API_APP__JWT_SECRET=
GO_API_APP__ADMIN_EMAIL=
GO_API_APP__ADMIN_PASSWORD=
GO_API_APP__DOCS_USER=admin
GO_API_APP__DOCS_PASSWORD=
GO_API_APP__DEFAULT_USER_PASSWORD=

# Browser origins; comma-separated, with * allowing all origins.
GO_API_CORS__ALLOW_ORIGINS=*

# Optional Redis and mail services.
GO_API_REDIS__ENABLED=false
GO_API_MAIL__ENABLED=false
GO_API_MAIL__FROM=

# Skip Auth; empty secret or paths disables the bypass.
GO_API_SKIP_AUTH__HEADER_NAME=X-Skip-Auth
GO_API_SKIP_AUTH__SECRET=
GO_API_SKIP_AUTH__PATHS=
