# The application reads config/config.yaml and selects a profile with APP_ENV.
APP_ENV=development

# Optional: use a different configuration file.
# CONFIG_FILE=./config/config.yaml

# Any GO_API_* variable overrides the corresponding YAML key.
# Double underscore separates nested keys; single underscore stays in a key name.
# GO_API_SERVER__PORT=9000
# GO_API_DATABASE__PASSWORD=change-me
# GO_API_DATABASE__ALLOW_DIRTY_MIGRATIONS=false
# GO_API_APP__JWT_SECRET=replace-with-at-least-32-characters
# GO_API_APP__DOCS_USER=admin
# GO_API_APP__DOCS_PASSWORD=replace-with-a-strong-password
# GO_API_APP__ADMIN_PASSWORD=replace-with-a-strong-password
# GO_API_APP__DEFAULT_USER_PASSWORD=replace-with-a-strong-password
# Optional reverse geocoding for GPS metadata (AMap)
# GO_API_APP__AMAP_API_KEY=
# GO_API_STORAGE__ENDPOINT=https://s3.amazonaws.com
# GO_API_STORAGE__BUCKET=go-api-starter
# GO_API_STORAGE__REGION=us-east-1
# GO_API_STORAGE__ACCESS_KEY_ID=
# GO_API_STORAGE__ACCESS_KEY_SECRET=
# GO_API_STORAGE__PUBLIC_BASE_URL=
# GO_API_STORAGE__FORCE_PATH_STYLE=false
# GO_API_STORAGE__MAX_FILE_SIZE=209715200
# Video transcoding is disabled by default. Enable it only when MPS is configured.
# GO_API_TRANSCODING__ENABLED=true
# GO_API_TRANSCODING__MPS_REGION=cn-hangzhou
# GO_API_TRANSCODING__MPS_PIPELINE_ID=your-pipeline-id
# GO_API_TRANSCODING__MPS_TEMPLATE_1080P=your-template-id
# GO_API_TRANSCODING__MPS_TEMPLATE_720P=your-template-id
# GO_API_TRANSCODING__MPS_TEMPLATE_480P=your-template-id
# GO_API_REDIS__PASSWORD=
# GO_API_WECHAT__SECRET=
# GO_API_MAIL__PASSWORD=
# Development default: allow standalone web clients from any origin.
# Production must override this with explicit trusted origins.
# GO_API_CORS__ALLOW_ORIGINS__0=*
