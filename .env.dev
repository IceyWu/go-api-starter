# Deprecated compatibility file. The application reads config/config.yaml directly.
# Use APP_ENV and GO_API_* variables; common defaults belong in config/config.yaml.
APP_ENV=development
GO_API_REDIS__ENABLED=true
GO_API_APP__JWT_SECRET=dev-jwt-secret-please-change-for-real-deployments
GO_API_APP__ADMIN_PASSWORD=123456
GO_API_OSS__REGION=oss-cn-hangzhou
GO_API_OSS__UPLOAD_DIR=go_oss
GO_API_MAIL__ENABLED=true
GO_API_MAIL__FROM=GoStarter
# Environment-specific overrides and secrets can be kept here when you explicitly source this file.
