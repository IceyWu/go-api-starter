# Development Environment
APP_ENV=development
SERVER_MODE=debug
BASE_PATH=
LOG_LEVEL=debug

# Database (use SQLite for zero-config; switch to mysql / postgres as needed)
DB_DRIVER=sqlite
DB_PATH=./data.db

# Redis (optional — keep disabled in local dev if you don't have Redis running)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# API Docs Basic Auth
DOCS_USER=admin
DOCS_PASSWORD=admin123

# Rate Limit
RATE_LIMIT_GLOBAL_PER_MINUTE=3000
RATE_LIMIT_USER_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=300
RATE_LIMIT_FALLBACK_RPS=500
RATE_LIMIT_FALLBACK_BURST=1000

# JWT
JWT_SECRET=dev-jwt-secret-please-change-for-real-deployments
ACCESS_TOKEN_DAYS=7
REFRESH_TOKEN_DAYS=30

# Default admin (leave empty to skip auto-creation)
ADMIN_EMAIL=
ADMIN_PASSWORD=123456

# OSS — fill in to enable upload features
ALICLOUD_OSS_ENDPOINT=
ALICLOUD_OSS_BUCKET=
ALICLOUD_OSS_REGION=oss-cn-hangzhou
ALICLOUD_ACCESS_KEY_ID=
ALICLOUD_ACCESS_KEY_SECRET=
ALICLOUD_OSS_UPLOAD_DIR=go_oss

# WebSocket 连接认证 Key（客户端连接 /ws/bot 时需携带）
WS_KEY=

# WeChat Mini-Program
WX_APPID=
WX_SECRET=

# Default user password (used for WeChat auto-registration)
DEFAULT_USER_PASSWORD=123456

# Mail Configuration
MAIL_ENABLED=true
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=GoStarter
MAIL_USE_TLS=true
MAIL_MOCK_SEND=true
